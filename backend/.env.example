# MediVerse AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (optional - uses SQLite by default)
# For MySQL: DATABASE_URL=mysql://user:password@localhost:3306/mediverse
# For PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/mediverse
# DATABASE_URL=

# Optional: External AI APIs (not required for core functionality)
# GROQ_API_KEY=
# GEMINI_API_KEY=
